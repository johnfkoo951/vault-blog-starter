{
  "name": "vault-blog-starter",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Write in an Obsidian vault, publish a citable static blog. Reader sidebars, bilingual APA citations, captioned images, search, RSS and SEO checks. By CMDSPACE.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnfkoo951/vault-blog-starter.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && npx serve dist",
    "test": "node --test tests/*.test.mjs",
    "seo": "node scripts/seo_audit.mjs",
    "citation": "node scripts/prepare-citation.mjs",
    "diagrams": "node scripts/diagrams.mjs",
    "test:diagram-reader": "node tests/diagram-reader-browser.cjs"
  },
  "dependencies": {
    "koroman": "1.0.16",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
